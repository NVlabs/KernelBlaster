# OpenAI-compatible Chat Completions endpoint. Never commit a real API key.
KERNELBLASTER_LLM_PROVIDER=openai_compatible
KERNELBLASTER_LLM_BASE_URL=https://your-gateway.example.com/v1
KERNELBLASTER_LLM_API_KEY=replace_with_your_api_key
MODEL=replace_with_your_gateway_model_id

# Provider controls
LLM_MAX_CONCURRENCY=4
LLM_MAX_RETRIES=3
LLM_REQUEST_TIMEOUT_SECONDS=1800
LLM_MAX_REQUESTS=0
LLM_MAX_TOTAL_TOKENS=0
LLM_MAX_COMPLETION_TOKENS=12288
# Optional for GPT-5.6 models: none, low, medium, high, xhigh, or max.
LLM_REASONING_EFFORT=low
STREAM=false

# Compose authentication. Copy this file outside the repository, generate two
# distinct random values, then pass it with --env-file while setting
# KERNELBLASTER_CONTROL_ENV_FILE to that external file. Compose forwards this
# file only to the control service; the GPU supervisor receives only its token.
KERNELBLASTER_CONTROL_TOKEN=replace_with_a_distinct_control_token
KERNELBLASTER_WORKER_TOKEN=replace_with_a_distinct_worker_token
KERNELBLASTER_SUPERVISOR_TOKEN=replace_with_a_distinct_supervisor_token
KERNELBLASTER_MAX_GPU_BINARY_BYTES=268435456
KERNELBLASTER_GPU_DEVICE=0
# Empty means the Supervisor accepts only the architecture detected at startup.
KERNELBLASTER_ALLOWED_TARGET_ARCHES=
KERNELBLASTER_ENABLE_GENERATED_GPU_JOBS=false
# Required only when KERNELBLASTER_ENABLE_GENERATED_GPU_JOBS=true. Build the
# gpu-job-image target and use its inspected sha256 image ID or a registry
# repository@sha256 digest; tags are rejected by the Supervisor.
KERNELBLASTER_GPU_JOB_IMAGE=
# stat -c '%g' /var/run/docker.sock on the Linux AutoDL host. Only the trusted
# Supervisor gets this socket; generated Job containers never do.
KERNELBLASTER_DOCKER_GID=
# Host path of a Supervisor-only profile manifest. It maps a profile ID to a
# CAS bundle containing private driver and seed assets. Do not add its contents
# to an LLM prompt or commit it to the repository.
KERNELBLASTER_PRIVATE_EVALUATION_PROFILES_HOST=
# Persistent SQLite/CAS state. This must be an Ubuntu ext4 or AutoDL-local path,
# never a Windows share, NFS, SMB, or repository-tracked directory.
KERNELBLASTER_STATE_HOST_DIR=../../runs/KernelBlaster/state
KERNELBLASTER_MAX_ARTIFACT_BYTES=268435456

# Prompt content is excluded from structured events by default.
LLM_LOG_CONTENT=false
